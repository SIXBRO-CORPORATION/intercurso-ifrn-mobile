{
  "expo": {
    "name": "Intercurso App",
    "slug": "intercurso-ifrn-mobile",
    "version": "1.0.0",
    "scheme": "intercursoapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samuelfranklin.zz.intercursoifrnmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/withCmakeObjectPathMax.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa sua galeria para você escolher a foto do time.",
          "cameraPermission": "O app acessa a câmera para você tirar a foto do time."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
